# Copy to apps/api-server/.env and fill in. Never commit .env.

ACI_ENVIRONMENT=development
ACI_LOG_LEVEL=INFO
ACI_LOG_JSON=true

# Supabase → Project Settings → Database → Connection string (URI).
# Use the "Session pooler" (port 5432) or "Direct connection" string. Both work.
# The transaction pooler (port 6543) also works: prepared statements are disabled for it.
# postgresql:// is converted to postgresql+psycopg:// automatically.
ACI_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Optional. Leave empty if you don't run Redis — status will show "not_configured".
ACI_REDIS_URL=

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ACI_JWT_SECRET=change-me-in-production-please-use-a-long-random-value
ACI_ACCESS_TOKEN_EXPIRE_MINUTES=60

ACI_CORS_ORIGINS=["http://localhost:3000"]

# Alert e-mails (MVP 08). Optional: without SMTP, e-mail deliveries are recorded as "skipped".
# Gmail: smtp.gmail.com, port 587, an App Password (not your account password).
ACI_SMTP_HOST=
ACI_SMTP_PORT=587
ACI_SMTP_USERNAME=
ACI_SMTP_PASSWORD=
ACI_SMTP_FROM=
ACI_SMTP_STARTTLS=true
ACI_SMTP_SSL=false
# Link added to alert e-mails, e.g. https://camera-agent-aci.vercel.app
ACI_PUBLIC_DASHBOARD_URL=
