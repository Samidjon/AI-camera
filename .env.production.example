# AI Camera Intelligence — production settings for docker-compose.yml.
# Copy to .env.production (gitignored), fill in, keep it private (chmod 600).

ACI_VERSION=1.0.0

# Public address users open. With a domain, Caddy obtains a TLS certificate automatically
# (ports 80/443 must reach this host). For a closed LAN without a domain use ACI_SITE_ADDRESS=:80
# and ACI_PUBLIC_URL=http://<server-ip>.
ACI_SITE_ADDRESS=cameras.example.com
ACI_PUBLIC_URL=https://cameras.example.com

# Secrets — generate, never reuse:  python -c "import secrets;print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=
ACI_JWT_SECRET=

# Optional: extra dashboard origins allowed to call the API (e.g. a Vercel deployment)
ACI_CORS_ORIGIN_REGEX=

# Optional: alert e-mails
ACI_SMTP_HOST=
ACI_SMTP_PORT=587
ACI_SMTP_USERNAME=
ACI_SMTP_PASSWORD=
ACI_SMTP_FROM=

# Ports published by Caddy
ACI_HTTP_PORT=80
ACI_HTTPS_PORT=443
