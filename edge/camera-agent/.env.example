# Copy to edge/camera-agent/.env. Never commit .env.

ACI_AGENT_ENVIRONMENT=development
ACI_AGENT_HOST=127.0.0.1          # 0.0.0.0 to accept dashboard connections from the LAN
ACI_AGENT_PORT=8100
ACI_AGENT_DATA_DIR=./data         # SQLite database + secret.key live here — back it up
ACI_AGENT_LOG_JSON=true

# Must equal ACI_JWT_SECRET of the central API server: dashboard tokens are verified locally,
# so camera management keeps working while the central server is offline.
ACI_AGENT_JWT_SECRET=

# Optional: explicit Fernet key for camera credentials (otherwise <data_dir>/secret.key is generated).
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ACI_AGENT_SECRET_KEY=

ACI_AGENT_CORS_ORIGINS=["http://localhost:3000"]
ACI_AGENT_MAX_CAMERAS=32

# Stream tuning (defaults are safe)
ACI_AGENT_STREAM_OPEN_TIMEOUT_S=8
ACI_AGENT_STREAM_READ_TIMEOUT_S=5
ACI_AGENT_STREAM_STALE_AFTER_S=4
ACI_AGENT_STREAM_RECONNECT_MAX_S=30
ACI_AGENT_STREAM_PREVIEW_MAX_FPS=10

# Standard Vision Engine (MVP 03)
ACI_AGENT_VISION_MAX_RSS_MB=1024          # above this, analysis pauses (capture continues)
# Local event database (events.db)
ACI_AGENT_EVENTS_RETENTION_DAYS=30
ACI_AGENT_EVENTS_MAX_DB_MB=512
ACI_AGENT_EVENTS_MIN_FREE_DISK_MB=500
